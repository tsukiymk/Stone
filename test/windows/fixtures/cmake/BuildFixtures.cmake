include("${CMAKE_CURRENT_LIST_DIR}/AndroidTools.cmake")
set(probe_java "${FIXTURE_ROOT}/art/java")

if(MODE STREQUAL "probe" OR MODE STREQUAL "core-probe")
    include("${FIXTURE_ROOT}/ProbeSources.cmake")
    if(MODE STREQUAL "core-probe")
        set(stone_probe_sources ${stone_probe_core_sources})
    else()
        set(USE_RUNTIME TRUE)
    endif()
    list(TRANSFORM stone_probe_sources PREPEND "${probe_java}/")
    dex(probe ${stone_probe_sources})
    file(COPY_FILE "${fixture_dex}" "${OUTPUT}/classes.dex")
elseif(MODE STREQUAL "cit")
    set(source "${FIXTURE_ROOT}/cit")
    resources("${source}/res" cit)
    set(generated "${stage}/generated")
    file(MAKE_DIRECTORY "${generated}")
    set(result "${stage}/stone-cit.apk")
    tool("${aapt}" link -I "${ANDROID_JAR}" --manifest "${source}/AndroidManifest.xml"
        --java "${generated}" -A "${source}/webview/assets" -A "${source}/native/assets"
        -0 txt -o "${result}" "${fixture_resources}")
    if(CIT_NATIVE)
        set(native_bundled true)
    else()
        set(native_bundled false)
    endif()
    file(WRITE "${generated}/CitBuild.java"
        "package com.trebledot.stone.cit;\nfinal class CitBuild { static final boolean NATIVE_BUNDLED = ${native_bundled}; }\n")
    file(GLOB_RECURSE sources "${source}/*.java" "${generated}/*.java")
    dex(cit ${sources})
    get_filename_component(dex_dir "${fixture_dex}" DIRECTORY)
    tool("${jar}" --update --file "${result}" -C "${dex_dir}" classes.dex)
    if(CIT_NATIVE)
        include("${CMAKE_CURRENT_LIST_DIR}/CitNative.cmake")
    endif()
    file(COPY_FILE "${result}" "${OUTPUT}/stone-cit.apk")
elseif(MODE STREQUAL "jobs" OR MODE STREQUAL "foreground")
    if(MODE STREQUAL "jobs")
        dex(jobs "${probe_java}/JobFixture.java")
    else()
        dex(foreground "${probe_java}/ForegroundFixture.java")
    endif()
    apk("${MODE}" "${FIXTURE_ROOT}/manifests/${MODE}.xml")
    if(MODE STREQUAL "jobs")
        key(fixture "CN=Stone Job Test")
        sign_apk("${fixture_apk}" "${OUTPUT}/jobs.apk" fixture)
    else()
        # Direct ART fixture; preserve the unsigned, non-installation contract.
        file(COPY_FILE "${fixture_apk}" "${OUTPUT}/foreground.apk")
    endif()
elseif(MODE STREQUAL "activity-routes")
    dex(activity "${probe_java}/ActivityRouteFixture.java")
    key(fixture "CN=Stone Activity Route Test")
    foreach(role source target)
        apk("${role}" "${FIXTURE_ROOT}/manifests/activity-${role}.xml")
        sign_apk("${fixture_apk}" "${OUTPUT}/${role}.apk" fixture)
    endforeach()
elseif(MODE STREQUAL "resize")
    file(MAKE_DIRECTORY "${stage}/res/values")
    file(WRITE "${stage}/res/values/bools.xml" "<resources><bool name=\"resize_enabled\">true</bool></resources>")
    resources("${stage}/res" resize)
    foreach(variant default-23 default-24 app-false activity-true activity-false resource-true alias)
        set(target 32)
        set(app_policy "")
        set(activity_policy "")
        if(variant MATCHES "^default-")
            string(REPLACE "default-" "" target "${variant}")
        elseif(variant STREQUAL "app-false" OR variant STREQUAL "activity-true" OR variant STREQUAL "alias")
            set(app_policy "android:resizeableActivity=\"false\"")
        elseif(variant STREQUAL "activity-false")
            set(app_policy "android:resizeableActivity=\"true\"")
        endif()
        if(variant STREQUAL "activity-true" OR variant STREQUAL "alias")
            set(activity_policy "android:resizeableActivity=\"true\"")
        elseif(variant STREQUAL "activity-false")
            set(activity_policy "android:resizeableActivity=\"false\"")
        elseif(variant STREQUAL "resource-true")
            set(activity_policy "android:resizeableActivity=\"@bool/resize_enabled\"")
        endif()
        set(filter "<intent-filter><action android:name=\"android.intent.action.MAIN\"/><category android:name=\"android.intent.category.LAUNCHER\"/></intent-filter>")
        set(activity "<activity android:name=\".Main\" android:exported=\"true\" ${activity_policy}>${filter}</activity>")
        if(variant STREQUAL "alias")
            set(activity "<activity android:name=\".Main\" android:exported=\"true\" ${activity_policy}/><activity-alias android:name=\".Launcher\" android:targetActivity=\".Main\" android:exported=\"true\">${filter}</activity-alias>")
        endif()
        file(WRITE "${stage}/AndroidManifest.xml" "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\" package=\"com.trebledot.stone.resizefixture\"><uses-sdk android:minSdkVersion=\"23\" android:targetSdkVersion=\"${target}\"/><application android:hasCode=\"false\" ${app_policy}>${activity}</application></manifest>")
        apk("${variant}" "${stage}/AndroidManifest.xml" "${fixture_resources}")
        file(COPY_FILE "${fixture_apk}" "${OUTPUT}/${variant}.apk")
    endforeach()
elseif(MODE STREQUAL "archives")
    include("${CMAKE_CURRENT_LIST_DIR}/ArchiveFixtures.cmake")
else()
    message(FATAL_ERROR "Unknown fixture mode: ${MODE}")
endif()
file(WRITE "${OUTPUT}/built.stamp" "${MODE}\n")
