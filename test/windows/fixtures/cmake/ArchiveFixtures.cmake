set(payload "Stone signature fixture payload 0123456789")
set(expected "")
foreach(identity a b)
    key("fixture-${identity}" "CN=Stone APK Test ${identity}")
    tool("${keytool}" -exportcert -keystore "${OUTPUT}/fixture-${identity}.p12"
        -storepass stone-test-only -alias fixture -file "${stage}/${identity}.der")
    file(SHA256 "${stage}/${identity}.der" digest)
    string(APPEND expected "${identity}.sha256=${digest}\n")
endforeach()
file(MAKE_DIRECTORY "${stage}/assets" "${stage}/res/values" "${stage}/res/values-zh" "${stage}/res/values-fr")
file(WRITE "${stage}/assets/payload.bin" "${payload}")
file(WRITE "${stage}/res/values/strings.xml" "<resources><string name=\"app_name\">Preapproved app</string></resources>")
file(WRITE "${stage}/res/values-zh/strings.xml" "<resources><string name=\"app_name\">预批准应用</string></resources>")
file(WRITE "${stage}/res/values-fr/strings.xml" "<resources><string name=\"app_name\">Application préapprouvée</string></resources>")
resources("${stage}/res" archive)
set(archive_resources "${fixture_resources}")
dex(launcher "${FIXTURE_ROOT}/art/java/LauncherFixtureActivity.java")
set(launcher_dex "${fixture_dex}")
set(variants v1 v2 v3 other unsigned v1-modern future native-32 service update downgrade other-package other-update
    other-bad-signer preapproval preapproval-update preapproval-label-changed preapproval-bad-signer
    uninstall uninstall-update launcher launcher-update launcher-service launcher-disabled
    automatic-installer automatic-installer-denied automatic-installer-update automatic-base
    automatic-update automatic-old-target automatic-bad-signer automatic-downgrade)
foreach(variant IN LISTS variants)
    set(target 32)
    if(variant STREQUAL "v1")
        set(target 28)
    endif()
    set(minimum 23)
    if(variant STREQUAL "future")
        set(minimum 38)
    endif()
    set(package com.trebledot.stone.install.fixture)
    if(variant MATCHES "^launcher")
        set(package com.trebledot.stone.install.launcher)
    elseif(variant MATCHES "^uninstall")
        set(package com.trebledot.stone.install.removal)
    elseif(variant MATCHES "^preapproval")
        set(package com.trebledot.stone.install.preapproved)
    elseif(variant MATCHES "^other-(package|update|bad-signer)$")
        set(package com.trebledot.stone.install.other)
    endif()
    set(version 7)
    if(variant STREQUAL "launcher-service")
        set(version 9)
    elseif(variant MATCHES "^(update|other-update|other-bad-signer|preapproval-update|preapproval-label-changed|preapproval-bad-signer|uninstall-update|launcher-update)$")
        set(version 8)
    elseif(variant STREQUAL "downgrade")
        set(version 6)
    endif()
    set(label "安装签名测试")
    if(variant STREQUAL "preapproval-label-changed")
        set(label "Changed app")
    elseif(variant MATCHES "^preapproval")
        set(label "@string/app_name")
    endif()
    set(components [=[<activity android:name=".Main" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity>]=])
    if(variant STREQUAL "service")
        set(components [=[<service android:name=".Background" android:exported="false" />]=])
    endif()
    set(app_attributes "")
    set(permissions "")
    if(variant MATCHES "^automatic-")
        set(package com.trebledot.stone.install.automatic)
        set(target 35)
        if(variant STREQUAL "automatic-old-target")
            set(target 34)
        endif()
        if(variant MATCHES "^automatic-installer")
            set(package com.trebledot.stone.install.manager)
            set(permissions [=[<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />]=])
            if(NOT variant STREQUAL "automatic-installer-denied")
                string(APPEND permissions [=[<uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" /><uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />]=])
            endif()
        endif()
        if(variant MATCHES "^automatic-(update|bad-signer|installer-update)$")
            set(version 8)
        elseif(variant STREQUAL "automatic-downgrade")
            set(version 6)
        endif()
    endif()
    unset(fixture_dex)
    if(variant MATCHES "^launcher")
        set(alias .Start)
        if(variant STREQUAL "launcher-update")
            set(alias .Updated)
        endif()
        set(components "<activity android:name=\"com.trebledot.stone.probe.LauncherFixtureActivity\" android:exported=\"false\" />\n<activity-alias android:name=\"${alias}\" android:targetActivity=\"com.trebledot.stone.probe.LauncherFixtureActivity\" android:exported=\"true\"><intent-filter><action android:name=\"android.intent.action.MAIN\" /><category android:name=\"android.intent.category.LAUNCHER\" /><category android:name=\"android.intent.category.DEFAULT\" /></intent-filter></activity-alias>\n")
        string(APPEND components [=[<activity android:name=".Private" android:exported="false"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity>
<activity android:name=".Disabled" android:enabled="false" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity>
<activity android:name=".Viewer" android:exported="true"><intent-filter><action android:name="android.intent.action.VIEW" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity>]=])
        set(app_attributes [=[android:name="com.trebledot.stone.probe.LauncherFixtureActivity$App"]=])
        if(variant STREQUAL "launcher-service")
            set(components [=[<service android:name=".Background" android:exported="false" />]=])
        elseif(variant STREQUAL "launcher-disabled")
            string(APPEND app_attributes " android:enabled=\"false\"")
        endif()
        set(fixture_dex "${launcher_dex}")
    endif()
    file(WRITE "${stage}/AndroidManifest.xml" "<manifest xmlns:android=\"http://schemas.android.com/apk/res/android\" package=\"${package}\" android:versionCode=\"${version}\" android:versionName=\"${version}.0\"><uses-sdk android:minSdkVersion=\"${minimum}\" android:targetSdkVersion=\"${target}\" /><uses-permission android:name=\"android.permission.INTERNET\" /><uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\" />${permissions}<application android:label=\"${label}\" ${app_attributes}>${components}</application></manifest>")
    set(resource_args)
    if(variant MATCHES "^preapproval")
        list(APPEND resource_args "${archive_resources}")
    endif()
    apk("${variant}" "${stage}/AndroidManifest.xml" -A "${stage}/assets" -0 bin ${resource_args})
    if(variant STREQUAL "native-32")
        file(MAKE_DIRECTORY "${stage}/native/lib/armeabi-v7a")
        file(WRITE "${stage}/native/lib/armeabi-v7a/libprobe.so" "ABI layout fixture; not executable code")
        tool("${jar}" --update --file "${fixture_apk}" -C "${stage}/native" lib)
    endif()
    if(variant STREQUAL "unsigned")
        file(COPY_FILE "${fixture_apk}" "${OUTPUT}/unsigned.apk")
        continue()
    endif()
    set(identity a)
    if(variant MATCHES "^(other|other-bad-signer|preapproval-bad-signer|automatic-bad-signer)$")
        set(identity b)
    endif()
    set(v1 false)
    set(v2 true)
    set(v3 false)
    if(variant STREQUAL "v1" OR variant STREQUAL "v1-modern")
        set(v1 true)
        set(v2 false)
    elseif(variant STREQUAL "v3")
        set(v2 false)
        set(v3 true)
    endif()
    sign_apk("${fixture_apk}" "${OUTPUT}/${variant}.apk" "fixture-${identity}" --key-pass pass:stone-test-only
        --min-sdk-version 23 --v1-signing-enabled "${v1}" --v2-signing-enabled "${v2}"
        --v3-signing-enabled "${v3}" --v4-signing-enabled false)
endforeach()
sign_apk("${CIT_APK}" "${OUTPUT}/launch.apk" fixture-a --key-pass pass:stone-test-only
    --min-sdk-version 23 --v1-signing-enabled false --v2-signing-enabled true
    --v3-signing-enabled false --v4-signing-enabled false)
set(signer_a --ks "${OUTPUT}/fixture-a.p12" --ks-key-alias fixture --ks-pass pass:stone-test-only --key-pass pass:stone-test-only)
set(signer_b --ks "${OUTPUT}/fixture-b.p12" --ks-key-alias fixture --ks-pass pass:stone-test-only --key-pass pass:stone-test-only)
foreach(kind rotated rotated-no-data)
    set(restriction)
    if(kind STREQUAL "rotated-no-data")
        set(restriction --set-installed-data false)
    endif()
    tool("${java}" -jar "${signer}" rotate --out "${stage}/${kind}.lineage"
        --old-signer ${signer_a} ${restriction} --new-signer ${signer_b})
    tool("${java}" -jar "${signer}" sign --min-sdk-version 23 --rotation-min-sdk-version 28
        --lineage "${stage}/${kind}.lineage" --v1-signing-enabled false --v2-signing-enabled false
        --v3-signing-enabled true --v4-signing-enabled false ${signer_b}
        --out "${OUTPUT}/${kind}.apk" "${stage}/v2.apk")
endforeach()
tool("${java}" -jar "${signer}" sign --min-sdk-version 23 --v1-signing-enabled false
    --v2-signing-enabled true --v3-signing-enabled false --v4-signing-enabled false
    ${signer_a} --next-signer ${signer_b} --out "${OUTPUT}/multi.apk" "${stage}/v2.apk")
file(MAKE_DIRECTORY "${stage}/mutator")
tool("${javac}" --release 21 -encoding UTF-8 -d "${stage}/mutator" "${FIXTURE_ROOT}/tools/ArchiveMutator.java")
foreach(variant v1 v2 v3 rotated multi)
    tool("${java}" -cp "${stage}/mutator" ArchiveMutator tamper
        "${OUTPUT}/${variant}.apk" "${OUTPUT}/tampered-${variant}.apk" "${payload}")
endforeach()
tool("${java}" -cp "${stage}/mutator" ArchiveMutator truncate "${OUTPUT}/tampered-multi.apk" "${OUTPUT}/truncated.apk")
if(SAMPLE_APK)
    execute_process(COMMAND "${aapt}" dump badging "${SAMPLE_APK}" OUTPUT_VARIABLE badging COMMAND_ERROR_IS_FATAL ANY)
    if(NOT badging MATCHES "package: name='([^']+)' versionCode='([0-9]+)'")
        message(FATAL_ERROR "Sample APK package/version missing")
    endif()
    string(APPEND expected "sample.package=${CMAKE_MATCH_1}\nsample.version=${CMAKE_MATCH_2}\n")
    execute_process(COMMAND "${java}" -jar "${signer}" verify --print-certs "${SAMPLE_APK}"
        OUTPUT_VARIABLE certificates COMMAND_ERROR_IS_FATAL ANY)
    string(REGEX MATCHALL "Signer #[0-9]+ certificate SHA-256 digest: [0-9a-fA-F]+" certificates "${certificates}")
    if(NOT certificates)
        message(FATAL_ERROR "Sample APK signing certificates missing")
    endif()
    set(digests)
    foreach(certificate IN LISTS certificates)
        string(REGEX REPLACE ".*digest: " "" digest "${certificate}")
        string(LENGTH "${digest}" length)
        if(NOT length EQUAL 64)
            message(FATAL_ERROR "Invalid sample signing certificate digest")
        endif()
        string(TOLOWER "${digest}" digest)
        list(APPEND digests "${digest}")
    endforeach()
    list(JOIN digests "," digests)
    file(SHA256 "${SAMPLE_APK}" digest)
    string(APPEND expected "sample.certificates=${digests}\nsample.sha256=${digest}\n")
    file(COPY_FILE "${SAMPLE_APK}" "${OUTPUT}/sample.apk")
endif()
file(WRITE "${OUTPUT}/expected.properties" "${expected}")
