cmake_minimum_required(VERSION 3.25)

if(NOT CONFIG STREQUAL "Debug")
    message(FATAL_ERROR "Test fixtures must be built with --config Debug")
endif()

foreach(input JDK ANDROID_JAR D8_JAR OUTPUT DEBUG_ROOT FIXTURE_ROOT)
    if(NOT DEFINED ${input} OR "${${input}}" STREQUAL "")
        message(FATAL_ERROR "Missing fixture input: ${input}")
    endif()
endforeach()
cmake_path(ABSOLUTE_PATH OUTPUT NORMALIZE)
cmake_path(ABSOLUTE_PATH DEBUG_ROOT NORMALIZE)
cmake_path(IS_PREFIX DEBUG_ROOT "${OUTPUT}" NORMALIZE inside_debug)
if(NOT inside_debug OR OUTPUT STREQUAL DEBUG_ROOT)
    message(FATAL_ERROR "Fixture output must be below the Debug directory: ${OUTPUT}")
endif()
if(SAMPLE_APK)
    cmake_path(ABSOLUTE_PATH SAMPLE_APK NORMALIZE)
    cmake_path(IS_PREFIX DEBUG_ROOT "${SAMPLE_APK}" NORMALIZE sample_inside_debug)
    if(NOT sample_inside_debug)
        message(FATAL_ERROR "Sample APK must be inside the Debug test directory")
    endif()
endif()
get_filename_component(build_tools_lib "${D8_JAR}" DIRECTORY)
get_filename_component(build_tools "${build_tools_lib}" DIRECTORY)
set(aapt "${build_tools}/aapt2.exe")
set(signer "${build_tools_lib}/apksigner.jar")
set(java "${JDK}/bin/java.exe")
set(javac "${JDK}/bin/javac.exe")
set(jar "${JDK}/bin/jar.exe")
set(keytool "${JDK}/bin/keytool.exe")
foreach(tool "${java}" "${javac}" "${jar}" "${ANDROID_JAR}" "${D8_JAR}")
    if(NOT EXISTS "${tool}")
        message(FATAL_ERROR "Missing Android fixture tool: ${tool}")
    endif()
endforeach()
set(stage "${OUTPUT}/obj/${MODE}")
# Only this fixture's intermediate directory may be replaced. Never remove a
# caller-supplied directory or the fixture keystores and published APKs.
cmake_path(IS_PREFIX OUTPUT "${stage}" NORMALIZE safe_stage)
if(NOT safe_stage OR stage STREQUAL OUTPUT)
    message(FATAL_ERROR "Fixture stage escaped its output directory")
endif()
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}" "${OUTPUT}")

function(tool)
    execute_process(COMMAND ${ARGV} COMMAND_ERROR_IS_FATAL ANY)
endfunction()

function(dex name)
    set(classes "${stage}/${name}/classes")
    set(destination "${stage}/${name}/dex")
    file(MAKE_DIRECTORY "${classes}" "${destination}")
    set(classpath "${ANDROID_JAR}")
    set(libraries)
    if(USE_RUNTIME)
        string(APPEND classpath ";${RUNTIME_JAR}")
        list(APPEND libraries --lib "${RUNTIME_JAR}")
    endif()
    execute_process(COMMAND "${javac}" --release 8 -Xlint:-options -encoding UTF-8
        -classpath "${classpath}" -d "${classes}" ${ARGN} COMMAND_ERROR_IS_FATAL ANY)
    tool("${jar}" --create --file "${stage}/${name}/classes.jar" -C "${classes}" .)
    tool("${java}" -cp "${D8_JAR}" com.android.tools.r8.D8 --min-api 23
        --lib "${ANDROID_JAR}" ${libraries} --output "${destination}" "${stage}/${name}/classes.jar")
    set(fixture_dex "${destination}/classes.dex" PARENT_SCOPE)
endfunction()

function(resources source name)
    tool("${aapt}" compile --dir "${source}" -o "${stage}/${name}.zip")
    set(fixture_resources "${stage}/${name}.zip" PARENT_SCOPE)
endfunction()

function(key name distinguished_name)
    set(file "${OUTPUT}/${name}.p12")
    if(NOT EXISTS "${file}")
        tool("${keytool}" -genkeypair -keystore "${file}" -storetype PKCS12
            -storepass stone-test-only -keypass stone-test-only -alias fixture
            -keyalg RSA -keysize 2048 -validity 3650 -dname "${distinguished_name}")
    endif()
endfunction()

function(sign_apk source destination key_name)
    tool("${java}" -jar "${signer}" sign --ks "${OUTPUT}/${key_name}.p12"
        --ks-pass pass:stone-test-only --ks-key-alias fixture --out "${destination}" ${ARGN} "${source}")
endfunction()

function(apk name manifest)
    set(result "${stage}/${name}.apk")
    tool("${aapt}" link -I "${ANDROID_JAR}" --manifest "${manifest}" -o "${result}" ${ARGN})
    if(DEFINED fixture_dex AND EXISTS "${fixture_dex}")
        get_filename_component(dex_dir "${fixture_dex}" DIRECTORY)
        tool("${jar}" --update --file "${result}" -C "${dex_dir}" classes.dex)
    endif()
    set(fixture_apk "${result}" PARENT_SCOPE)
endfunction()
