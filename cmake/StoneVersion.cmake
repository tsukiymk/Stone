# Shared by normal configuration and the release workflow's cmake -P invocation.
set(STONE_VERSION "" CACHE STRING "Display version (major.minor.build.0[-previewNN])")
set(STONE_PACKAGE_VERSION "1.0.0.0" CACHE STRING "Legacy numeric package version when STONE_VERSION is empty")
set(STONE_VERSION_PRERELEASE false)
if(STONE_VERSION)
    if(STONE_VERSION MATCHES "^v")
        string(SUBSTRING "${STONE_VERSION}" 1 -1 STONE_VERSION)
    endif()
    if(NOT STONE_VERSION MATCHES "^([1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.0(-preview([0-9]+))?$")
        message(FATAL_ERROR "Use major.minor.build.0[-previewNN], optionally prefixed with v.")
    endif()
    set(version_major "${CMAKE_MATCH_1}")
    set(version_minor "${CMAKE_MATCH_2}")
    set(version_build "${CMAKE_MATCH_3}")
    set(version_preview "${CMAKE_MATCH_5}")
    set(STONE_VERSION_BASE "${version_major}.${version_minor}.${version_build}.0")
    if(version_major GREATER 255 OR version_minor GREATER 255 OR version_build GREATER 65535)
        message(FATAL_ERROR "STONE_VERSION requires major 1..255, minor 0..255, build 0..65535.")
    endif()
    if(NOT version_preview STREQUAL "")
        string(REGEX REPLACE "^0+" "" version_preview "${version_preview}")
        if(version_preview STREQUAL "" OR version_preview GREATER 998)
            message(FATAL_ERROR "Preview number must be 1..998.")
        endif()
        set(STONE_VERSION_PRERELEASE true)
    endif()
    # Preview suffixes affect display/release identity, never numeric installer versions.
    set(STONE_PACKAGE_VERSION "${STONE_VERSION_BASE}")
else()
    if(NOT STONE_PACKAGE_VERSION MATCHES "^([1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.0$")
        message(FATAL_ERROR "STONE_PACKAGE_VERSION must be major.minor.build.0 without leading zeros.")
    endif()
    if(CMAKE_MATCH_1 GREATER 255 OR CMAKE_MATCH_2 GREATER 255 OR CMAKE_MATCH_3 GREATER 65535)
        message(FATAL_ERROR "Numeric package version exceeds MSI/MSIX limits.")
    endif()
    set(STONE_VERSION "${STONE_PACKAGE_VERSION}")
    set(STONE_VERSION_BASE "${STONE_PACKAGE_VERSION}")
endif()
string(REPLACE "." "," STONE_VERSION_RESOURCE "${STONE_PACKAGE_VERSION}")
if(DEFINED STONE_VERSION_OUTPUT)
    file(WRITE "${STONE_VERSION_OUTPUT}"
        "{\"version\":\"${STONE_VERSION}\",\"packageVersion\":\"${STONE_PACKAGE_VERSION}\",\"prerelease\":${STONE_VERSION_PRERELEASE}}\n")
endif()
