#include <winver.h>
#include "StoneVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION STONE_VERSION_RESOURCE
 PRODUCTVERSION STONE_VERSION_RESOURCE
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Trebledot Productions"
            VALUE "FileDescription", "@version_target@"
            VALUE "FileVersion", STONE_PACKAGE_VERSION_STRING
            VALUE "OriginalFilename", "@version_target@.exe"
            VALUE "ProductName", "Stone"
            VALUE "ProductVersion", STONE_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
