<UserControl
    x:Class="StoneSettings.Controls.TitleBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid
        x:Name="Root"
        Height="48"
        Background="Transparent"
        Loaded="TitleBarLoaded"
        SizeChanged="TitleBarSizeChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="ContentColumn" Width="Auto" />
            <ColumnDefinition x:Name="RightColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="TitleText.Visibility" Value="Collapsed" />
                        <Setter Target="LeftColumn.Width" Value="Auto" />
                        <Setter Target="RightColumn.Width" Value="Auto" />
                        <Setter Target="ContentColumn.Width" Value="*" />
                        <Setter Target="ContentHost.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel
            x:Name="Header"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                x:Uid="MainWindowPaneToggleButton"
                x:Name="PaneToggleButton"
                Width="40"
                Height="40"
                Margin="4,0,0,0"
                Style="{StaticResource SubtleButtonStyle}"
                Click="TogglePane">
                <FontIcon FontSize="16" Glyph="&#xE700;" />
            </Button>
            <TextBlock
                x:Name="TitleText"
                Margin="8,0,8,0"
                VerticalAlignment="Center"
                IsTextScaleFactorEnabled="False"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Title, Mode=OneWay}" />
        </StackPanel>
        <ContentPresenter
            x:Name="ContentHost"
            Grid.Column="1"
            Width="520"
            MaxWidth="520"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            Content="{x:Bind CenterContent, Mode=OneWay}" />
    </Grid>
</UserControl>
