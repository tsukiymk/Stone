<UserControl
    x:Class="StoneSettings.Controls.SystemImageDownloadCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource SettingCardStyle}" Padding="20">
        <StackPanel Spacing="12">
            <Grid ColumnSpacing="16" MinHeight="50">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="8" MinHeight="50">
                    <TextBlock x:Uid="ImageDownloadTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Uid="ImageDownloadSetupDescription" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="2" x:Name="RecommendedBadge" CornerRadius="4" Padding="8,3" VerticalAlignment="Top"
                        Visibility="Collapsed" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Uid="WelcomeRecommended" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="60,0,0,0">
                <Button x:Uid="ImageDownloadButton" x:Name="DownloadButton" Click="DownloadClicked" IsEnabled="{x:Bind State.CanDownload, Mode=OneWay}" />
                <Button x:Uid="ImageDownloadCancelButton" Click="CancelClicked" Visibility="{x:Bind State.ProgressVisibility, Mode=OneWay}" />
                <Button x:Uid="ImageDownloadUseButton" Click="UseClicked" Visibility="{x:Bind State.UseVisibility, Mode=OneWay}" IsEnabled="{x:Bind State.CanUse, Mode=OneWay}" />
            </StackPanel>
            <ProgressBar x:Uid="ImageDownloadProgress" Minimum="0" Maximum="100" Value="{x:Bind State.Percent, Mode=OneWay}"
                         IsIndeterminate="{x:Bind State.IsIndeterminate, Mode=OneWay}" Visibility="{x:Bind State.ProgressVisibility, Mode=OneWay}" />
            <TextBlock Text="{x:Bind State.Status, Mode=OneWay}" Visibility="{x:Bind State.StatusVisibility, Mode=OneWay}"
                       TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Border>
</UserControl>
