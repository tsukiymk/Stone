<Page
    x:Class="StoneSettings.Views.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StoneSettings.Models"
    xmlns:controls="using:StoneSettings.Controls">
    <Grid
        x:Name="AppsPanel"
        x:FieldModifier="internal"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource SettingCardStyle}" Padding="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    CornerRadius="12"
                    Width="48"
                    Height="48">
                    <FontIcon
                        Glyph="&#xE71D;"
                        FontSize="23"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Spacing="3"
                    VerticalAlignment="Center">
                    <TextBlock x:Uid="MainWindowInstalledAppsTextBlock" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="InstallButton"
                        AutomationProperties.AutomationId="InstallApk"
                        x:FieldModifier="internal"
                        Click="InstallClicked"
                        IsEnabled="{x:Bind ViewModel.CanManagePackages, Mode=OneWay}"
                        Style="{StaticResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock x:Uid="MainWindowInstallApkTextBlock" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <TextBlock
            x:Uid="MainWindowAppsListHeading"
            Grid.Row="1"
            x:Name="AppsListHeading"
            x:FieldModifier="internal"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Margin="2,8,0,0" />
        <ListView
            Grid.Row="2"
            x:Name="AppsList"
            AutomationProperties.AutomationId="AppsList"
            x:FieldModifier="internal"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="AppClicked"
            HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="CornerRadius" Value="8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:InstalledApp">
                    <Border Style="{StaticResource SettingCardStyle}" Padding="16,14">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:ApplicationIcon Width="40" Height="40" IconPng="{x:Bind IconPng}" AutomationProperties.Name="{x:Bind Name}" />
                            <StackPanel
                                Grid.Column="1"
                                Spacing="3"
                                VerticalAlignment="Center">
                                <TextBlock
                                    Text="{x:Bind Name}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Text="{x:Bind PackageName}"
                                    AutomationProperties.AutomationId="{x:Bind PackageName}"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="20"
                                VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Version}" Style="{StaticResource SecondaryTextStyle}" />
                                <FontIcon
                                    Glyph="&#xE76C;"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel
            Grid.Row="2"
            x:Name="EmptyApps"
            x:FieldModifier="internal"
            Spacing="10"
            HorizontalAlignment="Center"
            Margin="24,52">
            <FontIcon
                Glyph="&#xE71D;"
                FontSize="36"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock
                x:Uid="MainWindowEmptyTitle"
                x:Name="EmptyTitle"
                x:FieldModifier="internal"
                FontSize="18"
                FontWeight="SemiBold"
                HorizontalAlignment="Center" />
            <TextBlock
                x:Uid="MainWindowEmptyDescription"
                x:Name="EmptyDescription"
                x:FieldModifier="internal"
                Style="{StaticResource SecondaryTextStyle}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="360" />
        </StackPanel>
        <Grid
            x:Name="AppsLoadingPanel"
            x:FieldModifier="internal"
            Visibility="Collapsed"
            Grid.RowSpan="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <ProgressRing
                x:Uid="MainWindowAppsLoadingRing"
                x:Name="AppsLoadingRing"
                x:FieldModifier="internal"
                IsActive="False"
                Width="48"
                Height="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            <TextBlock
                x:Uid="MainWindowLoadingAppsStatusTextBlock"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0,108,0,0" />
        </Grid>
    </Grid>
</Page>
