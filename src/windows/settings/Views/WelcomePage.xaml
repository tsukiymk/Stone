<Page
    x:Class="StoneSettings.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StoneSettings.Controls">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Uid="WelcomeWindowWindowTitleBar" x:Name="WindowTitleBar">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///Assets/Stone.png" ShowAsMonochrome="False" />
            </TitleBar.IconSource>
        </TitleBar>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <Grid Padding="32,24,32,32">
                <StackPanel MaxWidth="560" Spacing="24" HorizontalAlignment="Stretch">
                    <Grid Margin="0,8,0,4" ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="10">
                            <TextBlock Text="STONE" FontSize="12" FontWeight="SemiBold" CharacterSpacing="160"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock x:Uid="WelcomeWindowWelcomeTitleTextBlock" AutomationProperties.AutomationId="WelcomeTitle" FontSize="32" FontWeight="SemiBold"
                                       TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level1" />
                            <TextBlock x:Uid="WelcomeWindowWelcomeDescriptionTextBlock" TextWrapping="Wrap" LineHeight="22"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Image Grid.Column="1" Source="ms-appx:///Assets/Stone.png" Width="92" Height="76"
                               VerticalAlignment="Center" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>

                    <StackPanel Spacing="12">
                        <TextBlock x:Uid="WelcomeSetupHeading" FontSize="14" FontWeight="SemiBold"
                                   AutomationProperties.HeadingLevel="Level2" Margin="0,0,0,2" />
                        <controls:SystemImageDownloadCard State="{x:Bind ViewModel.Download, Mode=OneWay}" IsPrimary="True"
                            DownloadRequested="DownloadRequested" CancelRequested="CancelRequested" UseRequested="UseRequested" />
                        <Border Style="{StaticResource SettingCardStyle}" Padding="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Width="44" Height="44" CornerRadius="12" VerticalAlignment="Top"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="8" MinHeight="50">
                                    <TextBlock x:Uid="WelcomeExistingImageTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Uid="WelcomeWindowWelcomeImageDescriptionTextBlock" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Row="1" Grid.Column="1" x:Uid="WelcomeWindowChooseImageButton" x:Name="ChooseImageButton"
                                        AutomationProperties.AutomationId="WelcomeChooseImage"
                                        Margin="0,12,0,0" HorizontalAlignment="Left" Click="ChooseImageClicked"
                                        IsEnabled="{x:Bind ViewModel.CanChooseImage, Mode=OneWay}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border x:Name="PreparingPanel" Style="{StaticResource SettingCardStyle}" Padding="16"
                            Visibility="{x:Bind ViewModel.PreparingVisibility, Mode=OneWay}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing x:Uid="WelcomeWindowPreparingRing" x:Name="PreparingRing"
                                          IsActive="{x:Bind ViewModel.IsPreparing, Mode=OneWay}" Width="28" Height="28" />
                            <StackPanel Grid.Column="1" Spacing="4" AutomationProperties.LiveSetting="Polite">
                                <TextBlock x:Uid="WelcomePreparingTitle" FontWeight="SemiBold" />
                                <TextBlock x:Uid="WelcomeWindowPreparingImageDescriptionTextBlock" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error"
                             Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                        <TextBlock x:Name="ErrorText" Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" />
                    </InfoBar>
                    <TextBlock x:Uid="WelcomeSetupFooter" TextWrapping="Wrap" FontSize="12" TextAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
