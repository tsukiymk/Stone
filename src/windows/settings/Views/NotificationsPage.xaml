<Page
    x:Class="StoneSettings.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:StoneSettings.Models"
    xmlns:controls="using:StoneSettings.Controls">
    <Grid
        x:Name="NotificationsPanel"
        x:FieldModifier="internal"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource SettingCardStyle}" Padding="20">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Background="{ThemeResource AccentFillColorTertiaryBrush}"
                    CornerRadius="12"
                    Width="48"
                    Height="48">
                    <FontIcon
                        Glyph="&#xEA8F;"
                        FontSize="23"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Spacing="3"
                    VerticalAlignment="Center">
                    <TextBlock x:Uid="MainWindowAllowAppNotificationsTextBlock" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        x:Uid="MainWindowNotificationsControlDescriptionTextBlock"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch
                    x:Uid="MainWindowAllNotifications"
                    x:Name="AllNotifications"
                    AutomationProperties.AutomationId="AllNotifications"
                    x:FieldModifier="internal"
                    Grid.Column="2"
                    Toggled="AllNotificationsToggled"
                    IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
                    VerticalAlignment="Center"
                    IsOn="{x:Bind ViewModel.GlobalEnabled, Mode=OneWay}" />
            </Grid>
        </Border>
        <Border
            Grid.Row="1"
            Style="{StaticResource SettingCardStyle}"
            Padding="18">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock x:Uid="MainWindowWindowsNotificationsTextBlock" FontWeight="SemiBold" />
                    <TextBlock
                        x:Uid="MainWindowWindowsNotificationsDescriptionTextBlock"
                        Style="{StaticResource SecondaryTextStyle}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Uid="MainWindowOpenWindowsNotificationsButton"
                    Grid.Column="1"
                    Click="WindowsNotificationsClicked"
                    VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A7;" FontSize="16" />
                </Button>
            </Grid>
        </Border>
        <TextBlock
            x:Uid="MainWindowAppNotificationsTextBlock"
            Grid.Row="2"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Margin="2,8,0,0" />
        <ListView
            x:Name="NotificationAppsList"
            x:FieldModifier="internal"
            Grid.Row="3"
            ItemsSource="{x:Bind ViewModel.Items}"
            SelectionMode="None"
            HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:InstalledApp">
                    <Border
                        Style="{StaticResource SettingCardStyle}"
                        Padding="18,14"
                        Margin="0,0,0,6">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:ApplicationIcon Width="40" Height="40" IconPng="{x:Bind IconPng}" AutomationProperties.Name="{x:Bind Name}" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind PackageName}" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Uid="MainWindowOnToggleSwitch"
                                Grid.Column="2"
                                Toggled="AppNotificationsToggled"
                                IsOn="{x:Bind NotificationsEnabled, Mode=OneWay}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Bind Name}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
