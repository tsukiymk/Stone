<UserControl
    x:Class="StoneSettings.Views.PackageConfirmationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StoneSettings.Controls"
    Loaded="PageLoaded">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeInvoked" />
    </UserControl.KeyboardAccelerators>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PermissionDialogBackground" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="PermissionDialogFooterBackground" Color="#202020" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PermissionDialogBackground" Color="White" />
                    <SolidColorBrush x:Key="PermissionDialogFooterBackground" Color="#F3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PermissionDialogBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PermissionDialogFooterBackground" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Style x:Key="PermissionDialogSurface" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource PermissionDialogBackground}" />
            </Style>
            <Style x:Key="PermissionDialogFooter" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource PermissionDialogFooterBackground}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
            <Style x:Key="PackageAccentText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="PackageSecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="PackageErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
            <Style x:Key="PackageAboutButton" TargetType="Button">
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="LayoutRoot"
        Padding="24,4,24,8"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Spacing="24">
                <Grid x:Name="Identity" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="IconColumn" Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Name="HeadingText"
                            Margin="0,0,0,4"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            AutomationProperties.HeadingLevel="Level1" />
                        <TextBlock
                            x:Name="PackageTypeText"
                            Style="{StaticResource PackageAccentText}"
                            FontSize="14" />
                        <TextBlock
                            x:Name="PackageNameText"
                            FontSize="13"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            x:Name="VersionText"
                            FontSize="13"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            x:Name="InstallerText"
                            FontSize="13"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <controls:ApplicationIcon
                        x:Name="AppIcon"
                        Grid.Column="1"
                        Width="90"
                        Height="90"
                        VerticalAlignment="Top" />
                </Grid>
                <StackPanel x:Name="FailurePanel" Spacing="16" Visibility="Collapsed">
                    <InfoBar
                        x:Name="FailureInfo"
                        AutomationProperties.AutomationId="InstallFailureReason"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Error" />
                    <TextBlock
                        x:Name="FailureSuggestion"
                        AutomationProperties.AutomationId="InstallFailureSuggestion"
                        TextWrapping="Wrap" />
                    <Expander x:Name="FailureDetails" HorizontalAlignment="Stretch">
                        <TextBlock
                            x:Name="FailureDetailsText"
                            TextWrapping="Wrap"
                            IsTextSelectionEnabled="True" />
                    </Expander>
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock x:Name="InformationHeading" FontSize="14" />
                    <StackPanel x:Name="PermissionList" Spacing="10" Visibility="Collapsed" Margin="0,6,0,0" />
                    <ProgressRing
                        x:Name="PreparationProgress"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Left"
                        IsActive="False"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="MessageText"
                        x:FieldModifier="internal"
                        FontSize="14"
                        TextWrapping="Wrap"
                        Style="{StaticResource PackageSecondaryText}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border
            x:Name="ActionFooter"
            Grid.Row="1"
            Margin="0,24,0,32">
            <Grid
                x:Name="Commands"
                ColumnSpacing="12"
                HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="PrimaryButton"
                    AutomationProperties.AutomationId="ConfirmPrimary"
                    x:FieldModifier="internal"
                    MinWidth="120"
                    Click="PrimaryClicked" />
                <Button
                    x:Name="CloseButton"
                    AutomationProperties.AutomationId="ConfirmCancel"
                    Grid.Column="1"
                    MinWidth="120"
                    Click="CancelClicked" />
            </Grid>
        </Border>

        <Button
            x:Name="AboutButton"
            Grid.Row="2"
            Width="32"
            Height="32"
            Padding="0"
            Margin="-8,0,0,0"
            HorizontalAlignment="Left"
            Style="{StaticResource PackageAboutButton}">
            <FontIcon Glyph="&#xE946;" FontSize="18" />
            <Button.Flyout>
                <Flyout Placement="TopEdgeAlignedLeft">
                    <StackPanel
                        x:Name="AboutContent"
                        Width="246"
                        Spacing="12">
                        <TextBlock x:Name="AboutHeading" FontSize="22" />
                        <TextBlock x:Name="AboutVersionText" TextWrapping="Wrap" />
                        <HyperlinkButton
                            x:Name="ProjectLink"
                            NavigateUri="https://github.com/Trebledot/Stone"
                            HorizontalAlignment="Left"
                            Padding="0,8,0,8" />
                        <HyperlinkButton
                            x:Name="NoticesLink"
                            HorizontalAlignment="Left"
                            Padding="0,8,0,8"
                            Click="NoticesClicked" />
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>
